{
  "manifest_version": 3,
  "name": "Easework",
  "version": "2.0.0",
  "icons": {
    "16": "./up.png",
    "48": "./up.png",
    "128": "./up.png"
  },
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.upwork.com/nx/search/jobs*"],
      "js": ["content.js"]
    }
  ],
  "permissions": ["tabs", "scripting", "storage", "alarms", "notifications"],
  "host_permissions": ["*://*/*"]
}
